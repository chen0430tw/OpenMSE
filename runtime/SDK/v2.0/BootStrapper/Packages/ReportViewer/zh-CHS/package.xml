<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/developer/2004/01/bootstrapper" Name="DisplayName" Culture="Culture" LicenseAgreement="eula.txt">

    <PackageFiles>
        <PackageFile Name="ReportViewerLP.exe" HomeSite="ReportViewerLPExe" PublicKey=""/>
        <PackageFile Name="eula.txt"/>
    </PackageFiles>

    <InstallChecks>
        <ExternalCheck PackageFile="ReportViewerChk.exe" Property="ReportViewerInstalled" Arguments="-lcid:2052"/>
    </InstallChecks>

    <Commands Reboot="Defer">
        <Command PackageFile="ReportViewerLP.exe" Arguments=" /q:a /c:&quot;install /q /l&quot;"> 
            <InstallConditions>
                <BypassIf Property="ReportViewerInstalled" Compare="ValueEqualTo" Value="2"/>

                <!-- Block install if user does not have admin privileges -->
                <FailIf Property="AdminUser" Compare="ValueEqualTo" Value="false" String="AdminRequired"/>

            </InstallConditions>

            <ExitCodes>
                <ExitCode Value="0" Result="Success"/>
                <ExitCode Value="3010" Result="SuccessReboot"/>
                <ExitCode Value="4097" Result="Fail" String="WindowsInstallerImproperInstall"/>
                <DefaultExitCode Result="Fail" FormatMessageFromSystem="true" String="GeneralFailure"/>
            </ExitCodes>
        </Command>
    </Commands>


    <!-- Defines a localizable string table for error messages and url's  -->
    <Strings>
        <String Name="DisplayName">Microsoft Visual Studio 2005 报表查看器</String>
        <String Name="Culture">zh-CHS</String>
        <String Name="AdminRequired">必须拥有管理员权限，才能安装 Microsoft Visual Studio 2005 报表查看器。请与管理员联系。</String>
        <String Name="DotNetFxRequired">安装 Microsoft Visual Studio 2005 报表查看器需要 Microsoft .NET Framework 2.0。请与应用程序供应商联系。</String>
        <String Name="WindowsInstallerImproperInstall">由于 Windows 安装程序出现错误，无法继续安装 Microsoft Visual Studio 2005 报表查看器。</String>
        <String Name="AnotherInstanceRunning">安装程序的另一实例已在运行。必须先完成正在运行的实例，然后才能继续执行此安装程序。</String>
        <String Name="BetaProductFailure">在计算机上检测到 Microsoft Visual Studio 2005 报表查看器 Beta 版。请先卸载任何以前的 Microsoft Visual Studio 2005 报表查看器 Beta 版，然后再继续操作。</String>
        <String Name="GeneralFailure">尝试安装 Microsoft Visual Studio 2005 报表查看器时出错。</String>
        <String Name="ReportViewerExe">http://go.microsoft.com/fwlink/?LinkId=49981</String>
        <String Name="ReportViewerLPExe">http://go.microsoft.com/fwlink/?LinkId=49981&amp;clcid=0x804</String>
    </Strings>

</Package>

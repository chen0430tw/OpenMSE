<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/developer/2004/01/bootstrapper" Name="DisplayName" Culture="Culture" LicenseAgreement="eula.txt">

    <PackageFiles>
        <PackageFile Name="langpack.exe" HomeSite="LangPackExe" PublicKey=""/>
        <PackageFile Name="eula.txt"/>
    </PackageFiles>

    <InstallChecks>
        <ExternalCheck PackageFile="dotnetchk.exe" Property="DotNetInstalled" Arguments="-lcid:2052"/>
        <RegistryCheck Property="IEVersion" Key="HKLM\Software\Microsoft\Internet Explorer" Value="Version"/>
    </InstallChecks>

    <Commands Reboot="Immediate">
        <Command PackageFile="langpack.exe" Arguments=" /q:a /c:&quot;install /l /q&quot;">
            <InstallConditions>
                <BypassIf Property="DotNetInstalled" Compare="ValueEqualTo" Value="2"/>

                <!-- Block install if user does not have admin privileges -->
                <FailIf Property="AdminUser" Compare="ValueEqualTo" Value="false" String="AdminRequired"/>

                <!-- Block install on Win95 -->
                <FailIf Property="Version9X" Compare="VersionLessThan" Value="4.10" String="InvalidPlatform"/>

                <!-- Block install if IE 5.01 or greater is not present -->
                <FailIf Property="IEVersion" Compare="ValueNotExists" String="InvalidPlatformIE"/>
                <FailIf Property="IEVersion" Compare="VersionLessThan" Value="5.01" String="InvalidPlatformIE"/>

                <!-- Block install on NT 4 or less -->
                <FailIf Property="VersionNT" Compare="VersionLessThan" Value="5.00" String="InvalidPlatform"/>

                <!-- Block install if the platform is not x86 -->
                <FailIf Property="ProcessorArchitecture" Compare="ValueNotEqualTo" Value="Intel" String="InvalidPlatformArchitecture"/>
            </InstallConditions>

            <ExitCodes>
                <ExitCode Value="0" Result="Success"/>
                <ExitCode Value="4097" Result="Fail" String="WindowsInstallerImproperInstall"/>
                <DefaultExitCode Result="Fail" FormatMessageFromSystem="true" String="GeneralFailure"/>
            </ExitCodes>
        </Command>
    </Commands>


    <!-- Defines a localizable string table for error messages and url's  -->
    <Strings>
        <String Name="DisplayName">.NET Framework 2.0</String>
        <String Name="Culture">zh-CHS</String>
        <String Name="AdminRequired">安装 .NET Framework 2.0 需要管理员权限。请与您的管理员联系。</String>
        <String Name="InvalidPlatformWin9x">不支持在 Windows 95 上安装 .NET Framework 2.0。请与您的应用程序供应商联系。</String>
        <String Name="InvalidPlatformWinNT">安装 .NET Framework 2.0 需要 Windows 2000 Service Pack 3 或更高版本。请与您的应用程序供应商联系。</String>
        <String Name="InvalidPlatformIE">安装 .NET Framework 2.0 需要 Internet Explorer 5.01 或更高版本。请与您的应用程序供应商联系。</String>
        <String Name="InvalidPlatformArchitecture">64 位操作系统不支持此版本的 .NET Framework 2.0。请与您的应用程序供应商联系。</String>
        <String Name="WindowsInstallerImproperInstall">由于 Windows Installer 的错误，无法继续安装 .NET Framework 2.0。</String>
        <String Name="AnotherInstanceRunning">安装程序的另一个实例已经运行。</String>
        <String Name="BetaNDPFailure">在计算机上检测到 .NET Framework 的测试版。在继续之前，请卸载 .NET Framework 的任何早期测试版本。</String>
        <String Name="GeneralFailure">试图安装 .NET Framework 2.0 时发生错误。</String>
        <String Name="DotNetFXExe">http://go.microsoft.com/fwlink/?LinkId=37283</String>
        <String Name="LangPackExe">http://go.microsoft.com/fwlink/?LinkId=37283&amp;clcid=0x804</String>
        <String Name="InstMsiAExe">http://go.microsoft.com/fwlink/?LinkId=37285</String>
        <String Name="Msi31Exe">http://go.microsoft.com/fwlink/?LinkId=49256</String>
    </Strings>

</Package>

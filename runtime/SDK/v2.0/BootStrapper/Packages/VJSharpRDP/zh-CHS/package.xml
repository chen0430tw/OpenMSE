<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/developer/2004/01/bootstrapper" Name="DisplayName" Culture="Culture" LicenseAgreement="eula.txt">

    <PackageFiles>
        <PackageFile Name="vjredist-LP.exe" HomeSite="VJRedistLPExe" PublicKey=""/>
        <PackageFile Name="eula.txt"/>
    </PackageFiles>

    <Schedules>
        <Schedule Name="BeforeVJSRDPInstall">
            <BeforePackage/>
        </Schedule>
    </Schedules>

    <InstallChecks>
        <ExternalCheck PackageFile="dotnetchk.exe" Property="DotNetInstalled" Arguments="-lcid:2052"/>
        <ExternalCheck PackageFile="vjsrdpchk.exe" Property="VJSRDPInstalled" Arguments="-lcid:2052"/>
    </InstallChecks>

    <Commands Reboot="Defer">
        <Command PackageFile="vjredist-LP.exe" Arguments=" /q:a /c:&quot;install /l /q&quot;">
            <InstallConditions>
                <BypassIf Property="VJSRDPInstalled" Compare="ValueEqualTo" Value="2"/>

                <!-- Block install if user does not have admin privileges -->
                <FailIf Property="AdminUser" Compare="ValueEqualTo" Value="false" String="AdminRequired"/>

                <!-- Block install if there is no .NET Framework -->
                <FailIf Property="DotNetInstalled" Compare="ValueEqualTo" Value="0" String="DotNetFxRequired" Schedule="BeforeVJSRDPInstall"/>
            </InstallConditions>

            <ExitCodes>
                <ExitCode Value="0" Result="Success"/>
                <ExitCode Value="3010" Result="SuccessReboot"/>
                <ExitCode Value="4096" Result="Fail" String="ImproperUsage"/>
                <ExitCode Value="4097" Result="Fail" String="WindowsInstallerImproperInstall"/>
                <ExitCode Value="4098" Result="Fail" String="OpenDatabaseFailure"/>
                <ExitCode Value="4099" Result="Fail" String="ReadDatabaseFailure"/>
                <ExitCode Value="4100" Result="Fail" String="SourceDirectoryTooLong"/>
                <ExitCode Value="4355" Result="Fail" String="TempDirectoryTooLong"/>
                <ExitCode Value="4356" Result="Fail" String="GetTempDirectoryFailure"/>
                <ExitCode Value="4357" Result="Fail" String="CannotWriteLogFile"/>
                <DefaultExitCode Result="Fail" FormatMessageFromSystem="true" String="GeneralFailure"/>
            </ExitCodes>
        </Command>
    </Commands>


    <!-- Defines a localizable string table for error messages and url's  -->
    <Strings>
        <String Name="DisplayName">Microsoft Visual J# .NET Redistributable Package 2.0</String>
        <String Name="Culture">zh-CHS</String>
        <String Name="AdminRequired">安装 Microsoft Visual J# .NET Redistributable Package 2.0 需要管理员权限。请与您的管理员联系。</String>
        <String Name="DotNetFxRequired">安装 Microsoft Visual J# .NET Redistributable Package 2.0 需要 Microsoft .NET Framework 2.0。请与您的应用程序供应商联系。</String>
        <String Name="WindowsInstallerImproperInstall">由于 Windows Installer 有错误，无法继续安装 Microsoft Visual J# .NET Redistributable Package 2.0。</String>
        <String Name="AnotherInstanceRunning">安装程序的另一个实例已经运行。必须完成正在运行的实例，此安装程序才能继续。</String>
        <String Name="BetaNDPFailure">在该计算机上检测到 Microsoft Visual J# .NET Redistributable Package 2.0 的测试版。在继续之前，请卸载 Microsoft Visual J# .NET Redistributable Package 的任何早期测试版本。</String>
        <String Name="GeneralFailure">试图安装 Microsoft Visual J# .NET Redistributable Package 2.0 时发生错误。</String>
        <String Name="VJRedistExe">http://go.microsoft.com/fwlink/?LinkId=37281</String>
        <String Name="VJRedistLPExe">http://go.microsoft.com/fwlink/?LinkId=37281&amp;clcid=0x804</String>
    </Strings>

</Package>

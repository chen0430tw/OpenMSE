<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>public static void main</Title>
            <Shortcut>psvm</Shortcut>
            <Description>main() 的扩展</Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="vjsharp" Format="CData"><![CDATA[public static void main(String[] args)
{
    $end$
}]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

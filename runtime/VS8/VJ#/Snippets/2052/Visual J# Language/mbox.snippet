<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>MessageBox.Show</Title>
            <Shortcut>mbox</Shortcut>
            <Description>简单的 MessageBox.Show 扩展</Description>
            <Author>Microsoft Corporation</Author> 
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
        <Declarations>
                <Literal default="true">
                    <ID>string</ID>
                    <ToolTip>要显示的字符串</ToolTip>
                    <Default>"Test"</Default>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[MessageBox.Show($string$);$end$]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>包</Title>
            <Shortcut>package</Shortcut>
            <Description>包的扩展代码段</Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal default="true">
                    <ID>name</ID>
                    <ToolTip>包名称</ToolTip>
                    <Default>MyPackage</Default>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[package $name$;
$selected$ $end$
]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

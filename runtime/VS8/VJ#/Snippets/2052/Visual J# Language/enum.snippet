<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>枚举</Title>
            <Shortcut>enum</Shortcut>
            <Description>枚举的扩展代码段</Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
                <SnippetType>SurroundWith</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal default="true">
                    <ID>name</ID>
                    <ToolTip>枚举名</ToolTip>
                    <Default>MyEnum</Default>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[enum $name$
{
        $selected$ $end$
}]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

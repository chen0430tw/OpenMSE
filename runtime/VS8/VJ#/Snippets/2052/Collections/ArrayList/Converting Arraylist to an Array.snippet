<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title> 将数组列表转换为数组 </Title>
            <Description> 用于将数组列表转换为数组的扩展代码段。  </Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>          
                <SnippetType> Expansion </SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID> ArrayList </ID>
                    <Default> arrList </Default>
                    <ToolTip> 要转换为数组的数组列表。 </ToolTip>
                </Literal>
                <Literal>
                    <ID> Array </ID>
                    <Default> objArr </Default>
                    <ToolTip> 用于保存要从数组列表转换的值的数组的变量 </ToolTip>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[java.lang.Object[] $Array$ = null;
if ($ArrayList$ != null && $ArrayList$.size() > 0)
{
    $Array$ = $ArrayList$.toArray();
}
$selected$ $end$
]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

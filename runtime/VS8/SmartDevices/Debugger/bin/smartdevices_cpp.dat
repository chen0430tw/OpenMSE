		#( 
			"[", 
            $e._Mysize , 
            "](", 
            
            #tree
            (
			head : $c._Myhead->_Parent, 
			skip : $c._Myhead, 
			left : _Left, 
			right : _Right,
			size  : $c._Mysize
		) : $e!_Myval, 
			
		")"
	)
    )
			   
	children
	(
		#tree
		(
			head : $c._Myhead->_Parent, 

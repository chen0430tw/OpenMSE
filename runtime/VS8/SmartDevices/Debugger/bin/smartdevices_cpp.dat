}

;------------------------------------------------------------------------------
;  std::complex
;------------------------------------------------------------------------------

std::complex<*>{
	preview
	(
		#if($e._Val[1] != 0)
		(	
			#if ($e._Val[0] != 0)				
			(
				#if ($e._Val[1] >= 0)
				(
					#($e._Val[0],"+i*", $e._Val[1])
				)
				#else
				(
					#($e._Val[0],"-i*", -$e._Val[1])
				)
			)
			#else
			(
				#if ($e._Val[1] >= 0.0)
				(
					#("i*", $e._Val[1])
				)
				#else
				(
					#("-i*", -$e._Val[1])
				)
			)
		)
		#else
		(
			$e._Val[0]		
		)
	)
}


// 字符串表
//

STRINGTABLE  
BEGIN
   IDC_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]   "[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]"
   IDS_APP_TITLE       "[!output PROJECT_NAME]"
END

[!else]

#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////

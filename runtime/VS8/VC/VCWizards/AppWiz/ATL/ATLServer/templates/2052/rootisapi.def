; [!output PROJECT_NAME].def : 声明 DLL 的模块参数。

[!if COMBINE_PROJECTS]
LIBRARY	     "[!output SAFE_PROJECT_IDENTIFIER_NAME]"
[!else]
LIBRARY	     "[!output PROJECT_NAME]"
[!endif]

EXPORTS
	HttpExtensionProc
	GetExtensionVersion
	TerminateExtension

//Microsoft Visual C++에서 생성한 리소스 스크립트입니다.
//
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE 2 리소스에서 생성되었습니다.
//

#include "afxres.h"

/////////////////////////////////////////////////////////////////////////////
#undef APSTUDIO_READONLY_SYMBOLS

#ifdef APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE  
BEGIN
	"resource.h\0"
END

2 TEXTINCLUDE  
BEGIN
	"#include ""afxres.h""\r\n"
	"\0"
END

3 TEXTINCLUDE  
BEGIN
    "#define _AFX_NO_SPLITTER_RESOURCES\r\n"
    "#define _AFX_NO_OLE_RESOURCES\r\n"
    "#define _AFX_NO_TRACKER_RESOURCES\r\n"
    "#define _AFX_NO_PROPERTY_RESOURCES\r\n"
    "\r\n"
    "#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])\r\n"
    "LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]\r\n"
    "#pragma code_page([!output SYSTEM_CODE_PAGE])\r\n"
    "#include ""[!output RES_PATH]\\[!output RC2_FILE_NAME].rc2""  // Microsoft Visual C++ 이외의 다른 도구에서 편집한 리소스입니다.\r\n"
    "#include ""afxres.rc""  	// 표준 구성 요소입니다.\r\n"
[!if PRINTING]
    "#include ""afxprint.rc""	// printing/print preview resources\r\n"
[!endif]
    "#endif\r\n"
	"\0"
END

#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// 아이콘
//

// 응용 프로그램 아이콘이 모든 시스템에서 일관된 상태를 유지하도록 하기 위해
// 가장 낮은 ID 값을 갖는 아이콘이 맨 처음 배치됩니다.

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
IDR_MAINFRAME		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME].ico"
[!if DOCVIEW && !APP_TYPE_DLG]
IDR_[!output SAFE_DOC_TYPE_NAME]TYPE		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME]Doc.ico"
[!endif]
#endif

[!if CMD_BAR_MENUNBUTTON]
/////////////////////////////////////////////////////////////////////////////
//
// 비트맵
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// 도구 모음
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
[!if DOCVIEW]
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
	SEPARATOR
[!endif]
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
	SEPARATOR
[!if DOCVIEW]
[!if PRINTING]
    BUTTON      ID_FILE_PRINT
[!endif]
[!endif]
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
[!if HELPSTYLE_WINHELP]
    BUTTON      ID_CONTEXT_HELP
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// 메뉴
//

IDR_MAINFRAME MENU  PRELOAD DISCARDABLE 
BEGIN
	POPUP "파일(&F)"
	BEGIN
[!if DOCVIEW]
		MENUITEM "새로 만들기(&N)\tCtrl+N",                ID_FILE_NEW
		MENUITEM "열기(&O)...\tCtrl+O",            ID_FILE_OPEN
		MENUITEM "저장(&S)\tCtrl+S",               ID_FILE_SAVE
		MENUITEM "다른 이름으로 저장(&A)...",                 ID_FILE_SAVE_AS
[!if PRINTING]
		MENUITEM SEPARATOR
		MENUITEM "인쇄(&P)...\tCtrl+P",           ID_FILE_PRINT
		MENUITEM "인쇄 미리 보기(&V)",              ID_FILE_PRINT_PREVIEW
		MENUITEM "인쇄 설정(&R)...",             ID_FILE_PRINT_SETUP
[!endif]
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "끝내기(&X)",                       ID_APP_EXIT
	END
	POPUP "편집(&E)"
	BEGIN
		MENUITEM "실행 취소(&U)\tCtrl+Z",               ID_EDIT_UNDO
		MENUITEM SEPARATOR
		MENUITEM "잘라내기(&T)\tCtrl+X",                ID_EDIT_CUT
		MENUITEM "복사(&C)\tCtrl+C",               ID_EDIT_COPY
		MENUITEM "붙여넣기(&P)\tCtrl+V",              ID_EDIT_PASTE
	END
[!if STATUS_BAR]
	POPUP "보기(&V)"
	BEGIN
		MENUITEM "상태 표시줄(&S)",                 ID_VIEW_STATUS_BAR
[!if LIST_VIEW]
        	MENUITEM SEPARATOR
        	MENUITEM "큰 아이콘(&G)",                ID_VIEW_LARGEICON
        	MENUITEM "작은 아이콘(&M)",                ID_VIEW_SMALLICON
        	MENUITEM "간단히(&L)",                       ID_VIEW_LIST
        	MENUITEM "자세히(&D)",                    ID_VIEW_DETAILS
        	MENUITEM SEPARATOR
        	POPUP "아이콘 정렬(&I)"
        	BEGIN
            		MENUITEM "이름순(&N)",                    ID_VIEW_BYNAME
            		MENUITEM SEPARATOR
            	MENUITEM "자동 정렬(&A)",               ID_VIEW_AUTOARRANGE
        	END
        MENUITEM "아이콘 줄 맞춤(&E)",              ID_VIEW_LINEUP
[!endif]
	END
[!endif]
	POPUP "도움말(&H)"
	BEGIN
[!if HELPSTYLE_WINHELP]
		MENUITEM "도움말 항목(&H)",                ID_HELP_FINDER
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "[!output PROJECT_NAME] 정보(&A)...",          ID_APP_ABOUT
	END
END

/////////////////////////////////////////////////////////////////////////////
//
// 액셀러레이터 키
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
	"S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
[!if PRINTING]
	"P",            ID_FILE_PRINT,          VIRTKEY,CONTROL
[!endif]
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
	VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
	VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
	VK_INSERT,      ID_EDIT_COPY,           VIRTKEY,CONTROL
	VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
	VK_F6,          ID_NEXT_PANE,           VIRTKEY 
	VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
[!if HELPSTYLE_WINHELP]
	VK_F1,          ID_CONTEXT_HELP,        VIRTKEY,SHIFT
	VK_F1,          ID_HELP,                VIRTKEY
[!endif]
END

/////////////////////////////////////////////////////////////////////////////
//
// 대화 상자
//
IDD_ABOUTBOX DIALOG DISCARDABLE   0, 0, 125, 55
CAPTION "[!output PROJECT_NAME] 정보"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "[!output PROJECT_NAME] 버전 1.0",IDC_STATIC,40,10,65,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC,40,25,65,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE  0, 0, 185, 93
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
	LTEXT	"TODO: 이 대화 상자에 폼 컨트롤을 배치합니다.",IDC_STATIC,24,42,136,8
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// 버전
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
		BEGIN 
            VALUE "CompanyName", "TODO: <회사 이름>"
            VALUE "FileDescription", "TODO: <파일 설명>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "[!output PROJECT_NAME].exe"
            VALUE "LegalCopyright", "TODO: (c) <회사 이름>.  All rights reserved."
			VALUE "OriginalFilename","[!output PROJECT_NAME].exe"
            VALUE "ProductName", "TODO: <제품 이름>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//
#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO DISCARDABLE 
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 133
        TOPMARGIN, 7
        BOTTOMMARGIN, 50
    END
[!if FORM_VIEW]
    IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 178
        TOPMARGIN, 7
        BOTTOMMARGIN, 86
    END
[!endif]
END
#endif  // APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
//
// 문자열 테이블
//
STRINGTABLE PRELOAD DISCARDABLE
BEGIN
// MAC을 대상으로 하지 않는 응용 프로그램에서는 두 개의 추가 부분 문자열을 제거합니다.
[!if !DOCVIEW]
	IDR_MAINFRAME           "[!output MAIN_FRAME_CAPTION]"
[!else]
[!if HAS_SUFFIX]  // 파일 접미사를 가집니다.
	IDR_MAINFRAME           "[!output MAIN_FRAME_CAPTION]\n\n[!output FILE_NEW_NAME_SHORT]\n[!output FILTER_NAME]\n.[!output FILE_EXTENSION]\n[!output FILE_TYPE_ID]\n[!output FILE_NEW_NAME_LONG]"
[!else]
	IDR_MAINFRAME           "[!output MAIN_FRAME_CAPTION]\n\n[!output FILE_NEW_NAME_SHORT]\n\n\n[!output FILE_TYPE_ID]\n[!output FILE_NEW_NAME_LONG]"
[!endif]
[!endif]
END
STRINGTABLE PRELOAD DISCARDABLE
BEGIN
	AFX_IDS_APP_TITLE       "[!output PROJECT_NAME]"
[!if HELPSTYLE_WINHELP]
	AFX_IDS_IDLEMESSAGE     "준비"
	AFX_IDS_HELPMODEMESSAGE "도움말을 보여 줄 개체를 선택하십시오."
[!else]
	AFX_IDS_IDLEMESSAGE     "준비"
[!endif]
END

STRINGTABLE DISCARDABLE 
BEGIN
	ID_FILE_NEW             "새 문서를 만듭니다.\n새로 만들기"
	ID_FILE_OPEN            "기존 문서를 엽니다.\n열기"
	ID_FILE_CLOSE           "활성 문서를 닫습니다.\n닫기"
	ID_FILE_SAVE            "활성 문서를 저장합니다.\n저장"
	ID_FILE_SAVE_AS         "활성 문서를 새 이름으로 저장합니다.\n다른 이름으로 저장"
[!if PRINTING]
	ID_FILE_PRINT           "활성 문서를 인쇄합니다.\n인쇄"
[!endif]
	ID_APP_ABOUT            "프로그램 정보, 버전 번호, 저작권을 표시합니다.\n정보"
	ID_APP_EXIT             "문서를 저장할지를 묻고 응용 프로그램을 끝냅니다.\n끝내기"
[!if HELPSTYLE_WINHELP]
	ID_HELP                 "현재 작업 또는 명령에 대한 도움말을 표시합니다.\n도움말"
[!endif]
	ID_NEXT_PANE            "다음 창으로 전환합니다.\n다음 창"
	ID_PREV_PANE            "이전 창으로 전환합니다.\n이전 창"
	ID_WINDOW_SPLIT         "활성 창을 여러 개의 창으로 분할합니다.\n분할"
	ID_EDIT_CLEAR           "선택 영역을 지웁니다.\n지우기"
	ID_EDIT_CLEAR_ALL       "모두 지웁니다.\n모두 지우기"
	ID_EDIT_COPY            "선택 영역을 복사하여 클립보드에 넣습니다.\n복사"
	ID_EDIT_CUT             "선택 영역을 잘라내어 클립보드에 넣습니다.\n잘라내기"
	ID_EDIT_FIND            "지정한 텍스트를 찾습니다.\n찾기"
	ID_EDIT_PASTE           "클립보드 내용을 삽입합니다.\n붙여넣기"
	ID_EDIT_REPEAT          "마지막 작업을 반복합니다.\n반복"
	ID_EDIT_REPLACE         "특정 텍스트를 다른 텍스트로 바꿉니다.\n바꾸기"
	ID_EDIT_SELECT_ALL      "전체 문서를 선택합니다.\n모두 선택"
	ID_EDIT_UNDO            "마지막 작업 실행을 취소합니다.\n실행 취소"
	ID_EDIT_REDO            "이전에 실행 취소된 작업을 다시 실행합니다.\n다시 실행"
END

STRINGTABLE DISCARDABLE 
BEGIN
	AFX_IDS_SCCLOSE         "문서를 저장할 것인지 확인하고 활성 창을 닫습니다."
	AFX_IDS_SCTASKLIST      "작업 목록을 활성화합니다."
END

STRINGTABLE DISCARDABLE 
BEGIN
	ID_INDICATOR_EXT        "EXT"
	ID_INDICATOR_CAPS       "CAP"
	ID_INDICATOR_NUM        "NUM"
	ID_INDICATOR_SCRL       "SCRL"
	ID_INDICATOR_OVR        "OVR"
	ID_INDICATOR_REC        "REC"
END

[!if SOCKETS]
STRINGTABLE DISCARDABLE
BEGIN
	IDP_SOCKETS_INIT_FAILED "Windows 소켓을 초기화하지 못했습니다."
END
[!endif]

[!if LIST_VIEW]

STRINGTABLE  
BEGIN
    ID_VIEW_SMALLICON       "작은 아이콘을 사용하여 항목을 표시합니다.\n작은 아이콘"
    ID_VIEW_LARGEICON       "큰 아이콘을 사용하여 항목을 표시합니다.\n큰 아이콘"
    ID_VIEW_LIST            "항목을 목록으로 표시합니다.\n간단히"
    ID_VIEW_DETAILS         "각 항목에 대한 자세한 정보를 창에 표시합니다.\n자세히"
    ID_VIEW_LINEUP          "모눈에 맞춰 아이콘을 정렬합니다."
    ID_VIEW_BYNAME          "사전순으로 아이콘을 정렬합니다."
END

STRINGTABLE  
BEGIN
    ID_VIEW_AUTOARRANGE         "모눈에 맞춰 아이콘을 정렬합니다."
END
[!endif]

#endif


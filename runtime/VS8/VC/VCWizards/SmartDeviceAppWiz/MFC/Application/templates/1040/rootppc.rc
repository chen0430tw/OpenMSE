/////////////////////////////////////////////////////////////////////////////
//
// Icona
//

// Icona con il valore ID minimo posto per primo in modo da garantire che l'icona dell'applicazione
// rimanga la stessa in tutti i sistemi.

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
IDR_MAINFRAME		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME].ico"
[!if DOCVIEW && !APP_TYPE_DLG]
IDR_[!output SAFE_DOC_TYPE_NAME]TYPE		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME]Doc.ico"
[!endif]
#endif

[!if CMD_BAR_MENUNBUTTON]
/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Barra degli strumenti
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
	POPUP "Menu"
	BEGIN
[!if DOCVIEW]
		POPUP "File"
		BEGIN
			MENUITEM "Salva",				ID_FILE_SAVE
		END
[!endif]
		POPUP "Modifica"
		BEGIN
			MENUITEM "Annulla",				ID_EDIT_UNDO
			MENUITEM SEPARATOR
			MENUITEM "Taglia",					ID_EDIT_CUT
			MENUITEM "Copia",				ID_EDIT_COPY
			MENUITEM "Incolla",				ID_EDIT_PASTE
		END
		POPUP "Strumenti"
		BEGIN
			MENUITEM "Informazioni su [!output PROJECT_NAME]...",	ID_APP_ABOUT
		END
[!if LIST_VIEW]
		POPUP "Visualizza"
		BEGIN
	        	MENUITEM SEPARATOR
        		MENUITEM "Icone grandi",                ID_VIEW_LARGEICON
	        	MENUITEM "Icone piccole",                ID_VIEW_SMALLICON
        		MENUITEM "Elenco",                       ID_VIEW_LIST
        		MENUITEM "Dettagli",                    ID_VIEW_DETAILS
        		MENUITEM SEPARATOR
        		POPUP "Disponi icone"
        		BEGIN
            			MENUITEM "Per nome",                    ID_VIEW_BYNAME
            			MENUITEM SEPARATOR
            		MENUITEM "Disposizione automatica",               ID_VIEW_AUTOARRANGE
        		END
        		MENUITEM "Allinea icone",              ID_VIEW_LINEUP
		END
[!endif]

	END
END
[!if APP_TYPE_SDI_DOCLIST]
IDR_DOCLIST MENU PRELOAD DISCARDABLE 
BEGIN
	POPUP "Menu"			
	BEGIN
		MENUITEM "Informazioni su [!output PROJECT_NAME]...",		ID_APP_ABOUT
	END
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// Tasto di scelta rapida
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
END

/////////////////////////////////////////////////////////////////////////////
//
// Finestra di dialogo
//
IDD_ABOUTBOX DIALOG DISCARDABLE 0, 0, 156, 129
CAPTION "Informazioni su [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT           "[!output PROJECT_NAME] Versione 1.0",IDC_STATIC_2,12,36,70,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC_3,12,48,66,8
END

IDD_ABOUTBOX_WIDE DIALOG DISCARDABLE 0, 0, 210, 129
CAPTION "Informazioni su [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT           "[!output PROJECT_NAME] Versione 1.0",IDC_STATIC_2,48,12,66,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC_3,48,24,66,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE 0, 0, 156, 129
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
	LTEXT	"TODO: inserire i controlli del form in questa finestra di dialogo.",IDC_STATIC,12,54,136,8
END
[!endif]


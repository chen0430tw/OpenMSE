BEGIN
[!if DOCVIEW]  
	ID_FILE_SAVE            "作業中のファイルを上書きして保存\n保存"
[!endif]
	ID_EDIT_UNDO            "直前に行った動作を元に戻す\n元に戻す"
	ID_EDIT_CUT             "選択範囲を切り取ってクリップボードに保存\n切り取り"
	ID_EDIT_COPY            "選択範囲をコピーしてクリップボードに保存\n保存"
	ID_EDIT_PASTE           "クリップボードの内容を貼り付け\n貼り付け"
END

STRINGTABLE DISCARDABLE 
BEGIN

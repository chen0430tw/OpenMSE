/////////////////////////////////////////////////////////////////////////////
//
// アイコン
//

// アプリケーションのアイコンをすべてのシステム上で維持するために、最も小さい
// ID 値のアイコンが最初に配置されます。

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
IDR_MAINFRAME		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME].ico"
[!if DOCVIEW && !APP_TYPE_DLG]
IDR_[!output SAFE_DOC_TYPE_NAME]TYPE		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME]Doc.ico"
[!endif]
#endif

[!if CMD_BAR_MENUNBUTTON]
/////////////////////////////////////////////////////////////////////////////
//
// ビットマップ
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// ツール バー
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// メニュー
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
	POPUP "メニュー"
	BEGIN
[!if DOCVIEW]
		POPUP "ファイル"
		BEGIN
			MENUITEM "保存",				ID_FILE_SAVE
		END
[!endif]
		POPUP "編集"
		BEGIN
			MENUITEM "元に戻す",				ID_EDIT_UNDO
			MENUITEM SEPARATOR
			MENUITEM "切り取り",					ID_EDIT_CUT
			MENUITEM "コピー",				ID_EDIT_COPY
			MENUITEM "貼り付け",				ID_EDIT_PASTE
		END
		POPUP "ツール"
		BEGIN
			MENUITEM "バージョン情報 [!output PROJECT_NAME]...",	ID_APP_ABOUT
		END
[!if LIST_VIEW]
		POPUP "表示"
		BEGIN
	        	MENUITEM SEPARATOR
        		MENUITEM "大きいアイコン",                ID_VIEW_LARGEICON
	        	MENUITEM "小さいアイコン",                ID_VIEW_SMALLICON
        		MENUITEM "リスト",                       ID_VIEW_LIST
        		MENUITEM "詳細",                    ID_VIEW_DETAILS
        		MENUITEM SEPARATOR
        		POPUP "アイコンの整列"
        		BEGIN
            			MENUITEM "名前順",                    ID_VIEW_BYNAME
            			MENUITEM SEPARATOR
            		MENUITEM "アイコンの自動整列",               ID_VIEW_AUTOARRANGE
        		END
        		MENUITEM "等間隔に整列",              ID_VIEW_LINEUP
		END
[!endif]

	END
END
[!if APP_TYPE_SDI_DOCLIST]
IDR_DOCLIST MENU PRELOAD DISCARDABLE 
BEGIN
	POPUP "メニュー"			
	BEGIN
		MENUITEM "バージョン情報 [!output PROJECT_NAME]...",		ID_APP_ABOUT
	END
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// アクセラレータ
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
END

/////////////////////////////////////////////////////////////////////////////
//
// ダイアログ
//
IDD_ABOUTBOX DIALOG DISCARDABLE 0, 0, 156, 129
CAPTION "バージョン情報 [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
FONT [!output ABOUTBOX_FONT_SIZE], "MS UI Gothic"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT           "[!output PROJECT_NAME] Version 1.0",IDC_STATIC_2,12,36,70,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC_3,12,48,66,8
END

IDD_ABOUTBOX_WIDE DIALOG DISCARDABLE 0, 0, 210, 129
CAPTION "バージョン情報 [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
FONT [!output ABOUTBOX_FONT_SIZE], "MS UI Gothic"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT           "[!output PROJECT_NAME] Version 1.0",IDC_STATIC_2,48,12,66,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC_3,48,24,66,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE 0, 0, 156, 129
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS UI Gothic"
BEGIN
	LTEXT	"TODO: フォームのコントロールをここに配置してください。",IDC_STATIC,12,54,136,8
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// バージョン
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
		BEGIN 
            VALUE "CompanyName", "TODO: <会社名>"
            VALUE "FileDescription", "TODO: <ファイルの説明>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "[!output PROJECT_NAME].exe"
            VALUE "LegalCopyright", "TODO: (C) <会社名>.  All rights reserved."
			VALUE "OriginalFilename","[!output PROJECT_NAME].exe"
            VALUE "ProductName", "TODO: <製品名>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END


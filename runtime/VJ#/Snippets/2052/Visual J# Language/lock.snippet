<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>synchronized 语句</Title>
            <Shortcut>sync</Shortcut>
            <Description>synchronized 语句的扩展代码段</Description> 
            <Author>Microsoft Corporation</Author> 
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
                <SnippetType>SurroundWith</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal default="this">
                    <ID>expression</ID>
                    <ToolTip>要计算的表达式</ToolTip>
                    <Default>this</Default>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[synchronized ($expression$)
{
    $selected$ $end$
}]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

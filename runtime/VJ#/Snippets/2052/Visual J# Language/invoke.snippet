<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>调用事件的安全方式</Title>
            <Shortcut>invoke</Shortcut>
            <Description>调用事件的安全方式</Description>
            <Author>Microsoft Corporation</Author>  
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal default="true">
                    <ID>event</ID>
                    <Default>MyEvent</Default>
            <ToolTip>要调用的事件方法</ToolTip>
                </Literal>
                <Literal>
                    <!-- Editable="false"> -->
                    <ID>MyDelegate</ID>
                    <Default>MyDelegate</Default>
            <ToolTip>委托类型</ToolTip>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[// safely invoke an event
{
$MyDelegate$ temp = $event$;
if (temp != null)
{
temp.Invoke($end$);
}
}]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

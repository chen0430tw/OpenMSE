<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>forr</Title>
            <Shortcut>forr</Shortcut>
            <Description>反向“for”循环的扩展代码段</Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
                <SnippetType>SurroundWith</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID>index</ID>
                    <Default>i</Default>
            <ToolTip>索引</ToolTip>
                </Literal>
                <Literal>
                    <ID>max</ID>
                    <Default>length</Default>
            <ToolTip>最大长度</ToolTip>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[for (int $index$ = $max$ - 1; $index$ >= 0 ; $index$--)
{
$selected$ $end$
}]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

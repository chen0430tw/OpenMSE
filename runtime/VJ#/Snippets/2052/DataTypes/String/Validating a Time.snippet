<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title> 验证时间 </Title>
            <Description> 用于验证给定时间的扩展代码段。 </Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>          
                <SnippetType> Expansion </SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID> Time </ID>
                    <Default> strTime </Default>
                    <ToolTip> 表示要验证的时间的字符串。 </ToolTip>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[
Boolean fValidTime = Boolean.TRUE; //variable is set to true if valid time is given else false
java.sql.Time objTime = null; 

//Check whether the time string is not null and not blank
if (($Time$ != null) && ($Time$.length() > 0))
{       
    try
    {
        if ($Time$ != null && $Time$.length() > 0)
            objTime = java.sql.Time.valueOf($Time$);
    }
    catch (Exception e)
    {
        fValidTime = Boolean.FALSE;
    }
}
else
{
    fValidTime = Boolean.FALSE;
}
$selected$ $end$
]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title> 确定文件夹是否存在 </Title>
            <Description> 用于确定文件夹是否存在的扩展代码段。 </Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>          
                <SnippetType> Expansion </SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID> DirName </ID>
                    <Default> strDirName </Default>
                    <ToolTip> 用于保存目录名的变量。 </ToolTip>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[
boolean flStatus  = false;  //variable is set to true if folder exists else false

//Check if folder name is not null and not blank
if ($DirName$ != null && $DirName$.length() > 0)
{
    flStatus = (new java.io.File( $DirName$ )).exists();
}
$selected$ $end$
]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

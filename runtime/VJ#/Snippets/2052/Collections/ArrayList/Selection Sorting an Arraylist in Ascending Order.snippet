<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
   <CodeSnippet Format="1.0.0">
        <Header>
            <Title> 按升对数组列表进行选择排序 </Title>
            <Description> 按升序对数组列表进行选择排序的扩展代码段。 </Description>
            <Author>Microsoft Corporation</Author>
            <SnippetTypes>          
                <SnippetType> Expansion </SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
            <Literal>
                    <ID> ArrayList </ID>
                    <Default> arrList </Default>
                    <ToolTip> 包含数字列表的数组列表。 </ToolTip>
                </Literal>
            </Declarations>
            <Code Language="vjsharp" Format="CData"><![CDATA[
for (int i  = 0; i < $ArrayList$.size() - 1; i++)  
{
    for (int j = i + 1; j < $ArrayList$.size(); j++) 
    {
        if (((java.lang.Integer)$ArrayList$.get(i)).ToInt32(null) > 
            ((java.lang.Integer)$ArrayList$.get(j)).ToInt32(null))
        {
            Object tempObj = $ArrayList$.get(i);
            $ArrayList$.set(i, $ArrayList$.get(j));
            $ArrayList$.set(j, tempObj);
        }
    }
}
$selected$ $end$
]]>
</Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>

<?xml version="1.0"?>
<VisualStudioPropertySheet 
	ProjectType="Visual C++" 
	Version="8.00" 
	Name="Core Windows Libraries">
	<Tool 
		Name="VCCLCompilerTool" 
		ProgramDataBaseFileName="$(IntDir)/vc80.pdb"/>
	<Tool 
		Name="VCLinkerTool" 
		AdditionalDependencies="coredll.lib corelibc.lib ole32.lib oleaut32.lib uuid.lib commctrl.lib"
		IgnoreDefaultLibraryNames="oldnames.lib"
		GenerateManifest="false"/>
</VisualStudioPropertySheet>

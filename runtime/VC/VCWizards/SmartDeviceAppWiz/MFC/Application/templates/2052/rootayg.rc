/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

// ID 值最低的图标放在最前面，以确保应用程序图标
// 在所有系统中保持一致。

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
IDR_MAINFRAME		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME].ico"
[!if DOCVIEW && !APP_TYPE_DLG]
IDR_[!output SAFE_DOC_TYPE_NAME]TYPE		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME]Doc.ico"
[!endif]
#endif

[!if CMD_BAR_MENUNBUTTON]
/////////////////////////////////////////////////////////////////////////////
//
// 位图
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// 工具栏
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
[!if DOCVIEW]
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
	SEPARATOR
[!endif]
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
	SEPARATOR
[!if DOCVIEW]
[!if PRINTING]
    BUTTON      ID_FILE_PRINT
[!endif]
[!endif]
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
[!if HELPSTYLE_WINHELP]
    BUTTON      ID_CONTEXT_HELP
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// 菜单
//

IDR_MAINFRAME MENU  PRELOAD DISCARDABLE 
BEGIN
	POPUP "文件(&F)"
	BEGIN
[!if DOCVIEW]
		MENUITEM "新建(&N)\tCtrl+N",                ID_FILE_NEW
		MENUITEM "打开(&O)...\tCtrl+O",            ID_FILE_OPEN
		MENUITEM "保存(&S)\tCtrl+S",               ID_FILE_SAVE
		MENUITEM "另存为(&A)...",                 ID_FILE_SAVE_AS
[!if PRINTING]
		MENUITEM SEPARATOR
		MENUITEM "打印(&P)...\tCtrl+P",           ID_FILE_PRINT
		MENUITEM "打印预览(&V)",              ID_FILE_PRINT_PREVIEW
		MENUITEM "打印设置(&R)...",             ID_FILE_PRINT_SETUP
[!endif]
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "退出(&X)",                       ID_APP_EXIT
	END
	POPUP "编辑(&E)"
	BEGIN
		MENUITEM "撤消(&U)\tCtrl+Z",               ID_EDIT_UNDO
		MENUITEM SEPARATOR
		MENUITEM "剪切(&T)\tCtrl+X",                ID_EDIT_CUT
		MENUITEM "复制(&C)\tCtrl+C",               ID_EDIT_COPY
		MENUITEM "粘贴(&P)\tCtrl+V",              ID_EDIT_PASTE
	END
[!if STATUS_BAR]
	POPUP "视图(&V)"
	BEGIN
		MENUITEM "状态栏(&S)",                 ID_VIEW_STATUS_BAR
[!if LIST_VIEW]
        	MENUITEM SEPARATOR
        	MENUITEM "大图标(&G)",                ID_VIEW_LARGEICON
        	MENUITEM "小图标(&M)",                ID_VIEW_SMALLICON
        	MENUITEM "列表(&L)",                       ID_VIEW_LIST
        	MENUITEM "详细信息(&D)",                    ID_VIEW_DETAILS
        	MENUITEM SEPARATOR
        	POPUP "排列图标(&I)"
        	BEGIN
            		MENUITEM "按名称(&N)",                    ID_VIEW_BYNAME
            		MENUITEM SEPARATOR
            	MENUITEM "自动排列(&A)",               ID_VIEW_AUTOARRANGE
        	END
        MENUITEM "对齐图标(&E)",              ID_VIEW_LINEUP
[!endif]

	END
[!endif]
	POPUP "帮助(&H)"
	BEGIN
[!if HELPSTYLE_WINHELP]
		MENUITEM "帮助主题(&H)",                ID_HELP_FINDER
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "关于 [!output PROJECT_NAME](&A)...",          ID_APP_ABOUT
	END
END

[!if !SMARTPHONE2003_UI_MODEL]
/////////////////////////////////////////////////////////////////////////////
//
// 快捷键
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
	"S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
[!if PRINTING]
	"P",            ID_FILE_PRINT,          VIRTKEY,CONTROL
[!endif]
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
	VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
	VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
	VK_INSERT,      ID_EDIT_COPY,           VIRTKEY,CONTROL
	VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
	VK_F6,          ID_NEXT_PANE,           VIRTKEY 
	VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
[!if HELPSTYLE_WINHELP]
	VK_F1,          ID_CONTEXT_HELP,        VIRTKEY,SHIFT
	VK_F1,          ID_HELP,                VIRTKEY
[!endif]
END

/////////////////////////////////////////////////////////////////////////////
//
// 对话框
//
IDD_ABOUTBOX DIALOG DISCARDABLE   0, 0, 125, 55
CAPTION "关于 [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "[!output PROJECT_NAME] 1.0 版",IDC_STATIC,40,10,65,8,SS_NOPREFIX
    LTEXT           "版权所有 (C) [!output YEAR]",IDC_STATIC,40,25,65,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE  0, 0, 185, 93
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
	LTEXT	"TODO: 将窗体控件放置在此对话框上。",IDC_STATIC,24,42,136,8
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// 版本
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
		BEGIN 
            VALUE "CompanyName", "TODO: <公司名>"
            VALUE "FileDescription", "TODO: <文件说明>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "[!output PROJECT_NAME].exe"
            VALUE "LegalCopyright", "TODO: (C) <公司名>。保留所有权利。"
			VALUE "OriginalFilename","[!output PROJECT_NAME].exe"
            VALUE "ProductName", "TODO: <产品名>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//
#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO DISCARDABLE 
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 133
        TOPMARGIN, 7
        BOTTOMMARGIN, 50
    END
[!if FORM_VIEW]
    IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 178
        TOPMARGIN, 7
        BOTTOMMARGIN, 86
    END
[!endif]
END
#endif  // APSTUDIO_INVOKED
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// 字符串表
//
STRINGTABLE PRELOAD DISCARDABLE
BEGIN
// 非 Mac 应用程序将移除额外的两个子字符串
[!if !DOCVIEW]
	IDR_MAINFRAME           "[!output MAIN_FRAME_CAPTION]"
[!else]
[!if HAS_SUFFIX]  // 有一个文件后缀
	IDR_MAINFRAME           "[!output MAIN_FRAME_CAPTION]\n\n[!output FILE_NEW_NAME_SHORT]\n[!output FILTER_NAME]\n.[!output FILE_EXTENSION]\n[!output FILE_TYPE_ID]\n[!output FILE_NEW_NAME_LONG]"
[!else]
	IDR_MAINFRAME           "[!output MAIN_FRAME_CAPTION]\n\n[!output FILE_NEW_NAME_SHORT]\n\n\n[!output FILE_TYPE_ID]\n[!output FILE_NEW_NAME_LONG]"
[!endif]
[!endif]
END
STRINGTABLE PRELOAD DISCARDABLE
BEGIN
	AFX_IDS_APP_TITLE       "[!output PROJECT_NAME]"
[!if HELPSTYLE_WINHELP]
	AFX_IDS_IDLEMESSAGE     "就绪"
	AFX_IDS_HELPMODEMESSAGE "选择要获取其帮助信息的对象"
[!else]
	AFX_IDS_IDLEMESSAGE     "就绪"
[!endif]
END

STRINGTABLE DISCARDABLE 
BEGIN
	ID_FILE_NEW             "创建新文档\n新建"
	ID_FILE_OPEN            "打开现有文档\n打开"
	ID_FILE_CLOSE           "关闭活动文档\n关闭"
	ID_FILE_SAVE            "保存活动文档\n保存"
	ID_FILE_SAVE_AS         "用新名称保存活动文档\n另存为"
[!if PRINTING]
	ID_FILE_PRINT           "打印活动文档\n打印"
[!endif]
	ID_APP_ABOUT            "显示程序信息、版本号和版权\n关于"
	ID_APP_EXIT             "退出应用程序；提示保存文档\n退出"
[!if HELPSTYLE_WINHELP]
	ID_HELP                 "显示当前任务或命令的帮助信息\n帮助"
[!endif]
	ID_NEXT_PANE            "切换到下一个窗格\n下一窗格"
	ID_PREV_PANE            "切换回上一个窗格\n上一窗格"
	ID_WINDOW_SPLIT         "将活动窗口拆分为多个窗格\n拆分"
	ID_EDIT_CLEAR           "清除选定内容\n清除"
	ID_EDIT_CLEAR_ALL       "清除全部内容\n全部清除"
	ID_EDIT_COPY            "复制选定内容并将其放到剪贴板上\n复制"
	ID_EDIT_CUT             "剪切选定内容并将其放到剪贴板上\n剪切"
	ID_EDIT_FIND            "查找指定的文本\n查找"
	ID_EDIT_PASTE           "插入剪贴板内容\n粘贴"
	ID_EDIT_REPEAT          "重复上一操作\n重复"
	ID_EDIT_REPLACE         "用其他文本替换特定的文本\n替换"
	ID_EDIT_SELECT_ALL      "选定整个文档\n全选"
	ID_EDIT_UNDO            "撤消上一操作\n撤消"
	ID_EDIT_REDO            "恢复上次撤消的操作\n重做"
END

STRINGTABLE DISCARDABLE 
BEGIN
	AFX_IDS_SCCLOSE         "关闭活动窗口并提示保存文档"
	AFX_IDS_SCTASKLIST      "激活任务列表"
END


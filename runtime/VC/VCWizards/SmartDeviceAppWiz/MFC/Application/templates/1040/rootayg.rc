//
// Icona
//

// Icona con il valore ID minimo posto per primo in modo da garantire che l'icona dell'applicazione
// rimanga la stessa in tutti i sistemi.

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]

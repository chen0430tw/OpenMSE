/////////////////////////////////////////////////////////////////////////////
//
// Icono
//

// Icono con el valor de id. menor colocado en primer lugar para garantizar que el icono de la aplicación
// es el mismo en todos los sistemas.

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
IDR_MAINFRAME		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME].ico"
[!if DOCVIEW && !APP_TYPE_DLG]
IDR_[!output SAFE_DOC_TYPE_NAME]TYPE		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME]Doc.ico"
[!endif]
#endif

[!if CMD_BAR_MENUNBUTTON]
/////////////////////////////////////////////////////////////////////////////
//
// Mapa de bits
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Barra de herramientas
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// Menú
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
	POPUP "Menú"
	BEGIN
[!if DOCVIEW]
		POPUP "Archivo"
		BEGIN
			MENUITEM "Guardar",				ID_FILE_SAVE
		END
[!endif]
		POPUP "Editar"
		BEGIN
			MENUITEM "Deshacer",				ID_EDIT_UNDO
			MENUITEM SEPARATOR
			MENUITEM "Cortar",					ID_EDIT_CUT
			MENUITEM "Copiar",				ID_EDIT_COPY
			MENUITEM "Pegar",				ID_EDIT_PASTE
		END
		POPUP "Herramientas"
		BEGIN
			MENUITEM "Acerca de [!output PROJECT_NAME]...",	ID_APP_ABOUT
		END
[!if LIST_VIEW]
		POPUP "Vista"
		BEGIN
	        	MENUITEM SEPARATOR
        		MENUITEM "Iconos grandes",                ID_VIEW_LARGEICON
	        	MENUITEM "Iconos pequeños",                ID_VIEW_SMALLICON
        		MENUITEM "Lista",                       ID_VIEW_LIST
        		MENUITEM "Detalles",                    ID_VIEW_DETAILS
        		MENUITEM SEPARATOR
        		POPUP "Organizar iconos"
        		BEGIN
            			MENUITEM "Por nombre",                    ID_VIEW_BYNAME
            			MENUITEM SEPARATOR
            		MENUITEM "Autoorganizar",               ID_VIEW_AUTOARRANGE
        		END
        		MENUITEM "Alinear iconos",              ID_VIEW_LINEUP
		END
[!endif]

	END
END
[!if APP_TYPE_SDI_DOCLIST]
IDR_DOCLIST MENU PRELOAD DISCARDABLE 
BEGIN
	POPUP "Menú"			
	BEGIN
		MENUITEM "Acerca de [!output PROJECT_NAME]...",		ID_APP_ABOUT
	END
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// Acelerador
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"n",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"v",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
END

/////////////////////////////////////////////////////////////////////////////
//
// Cuadro de diálogo
//
IDD_ABOUTBOX DIALOG DISCARDABLE 0, 0, 156, 129
CAPTION "Acerca de [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT           "[!output PROJECT_NAME], versión 1.0",IDC_STATIC_2,12,36,70,8,SS_NOPREFIX
    LTEXT           "(C) [!output YEAR]",IDC_STATIC_3,12,48,66,8
END

IDD_ABOUTBOX_WIDE DIALOG DISCARDABLE 0, 0, 210, 129
CAPTION "Acerca de [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT           "[!output PROJECT_NAME], versión 1.0",IDC_STATIC_2,48,12,66,8,SS_NOPREFIX
    LTEXT           "(C) [!output YEAR]",IDC_STATIC_3,48,24,66,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE 0, 0, 156, 129
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
	LTEXT	"TODO: colocar controles de formulario en este cuadro de diálogo.",IDC_STATIC,12,54,136,8
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// Versión
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
		BEGIN 
            VALUE "CompanyName", "TODO: <Nombre de la compañía>"
            VALUE "FileDescription", "TODO: <Descripción del archivo>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "[!output PROJECT_NAME].exe"
            VALUE "LegalCopyright", "TODO: (c) <Nombre de la compañía>. Reservados todos los derechos."
			VALUE "OriginalFilename","[!output PROJECT_NAME].exe"
            VALUE "ProductName", "TODO: <Nombre del producto>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END


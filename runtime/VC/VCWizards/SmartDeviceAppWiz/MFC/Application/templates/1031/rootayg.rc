/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Symbolleiste
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
[!if DOCVIEW]
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
	SEPARATOR
[!endif]
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
	SEPARATOR
[!if DOCVIEW]
[!if PRINTING]
    BUTTON      ID_FILE_PRINT
[!endif]
[!endif]
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
[!if HELPSTYLE_WINHELP]
    BUTTON      ID_CONTEXT_HELP
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// Menü
//

IDR_MAINFRAME MENU  PRELOAD DISCARDABLE 
BEGIN
	POPUP "&Datei"
	BEGIN
[!if DOCVIEW]
		MENUITEM "&Neu\tStrg+N",                ID_FILE_NEW
		MENUITEM "Ö&ffnen...\tStrg+O",            ID_FILE_OPEN
		MENUITEM "&Speichern\tStrg+S",               ID_FILE_SAVE
		MENUITEM "Speichern &unter...",                 ID_FILE_SAVE_AS
[!if PRINTING]
		MENUITEM SEPARATOR
		MENUITEM "&Drucken...\tStrg+P",           ID_FILE_PRINT
		MENUITEM "&Seitenansicht",              ID_FILE_PRINT_PREVIEW
		MENUITEM "Dru&ckeinrichtung...",             ID_FILE_PRINT_SETUP
[!endif]
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "&Beenden",                       ID_APP_EXIT
	END
	POPUP "&Bearbeiten"
	BEGIN
		MENUITEM "&Rückgängig\tStrg+Z",               ID_EDIT_UNDO
		MENUITEM SEPARATOR
		MENUITEM "&Ausschneiden\tStrg+X",                ID_EDIT_CUT
		MENUITEM "&Kopieren\tStrg+C",               ID_EDIT_COPY
		MENUITEM "&Einfügen\tStrg+V",              ID_EDIT_PASTE
	END
[!if STATUS_BAR]
	POPUP "&Ansicht"
	BEGIN
		MENUITEM "Status&leiste",                 ID_VIEW_STATUS_BAR
[!if LIST_VIEW]
        	MENUITEM SEPARATOR
        	MENUITEM "&Große Symbole",                ID_VIEW_LARGEICON
        	MENUITEM "K&leine Symbole",                ID_VIEW_SMALLICON
        	MENUITEM "&Liste",                       ID_VIEW_LIST
        	MENUITEM "&Details",                    ID_VIEW_DETAILS
        	MENUITEM SEPARATOR
        	POPUP "S&ymbole anordnen"
        	BEGIN
            		MENUITEM "Nach &Namen",                    ID_VIEW_BYNAME
            		MENUITEM SEPARATOR
            	MENUITEM "&Automatisch anordnen",               ID_VIEW_AUTOARRANGE
        	END
        MENUITEM "Symbol&e ausrichten",              ID_VIEW_LINEUP
[!endif]

	END
[!endif]
	POPUP "&Hilfe"
	BEGIN
[!if HELPSTYLE_WINHELP]
		MENUITEM "Hilfe&themen",                ID_HELP_FINDER
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "&Info über [!output PROJECT_NAME]...",          ID_APP_ABOUT
	END
END

[!if !SMARTPHONE2003_UI_MODEL]
/////////////////////////////////////////////////////////////////////////////
//
// Zugriffstaste
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
	"S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
[!if PRINTING]
	"P",            ID_FILE_PRINT,          VIRTKEY,CONTROL
[!endif]
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
	VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
	VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
	VK_INSERT,      ID_EDIT_COPY,           VIRTKEY,CONTROL
	VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
	VK_F6,          ID_NEXT_PANE,           VIRTKEY 
	VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
[!if HELPSTYLE_WINHELP]
	VK_F1,          ID_CONTEXT_HELP,        VIRTKEY,SHIFT
	VK_F1,          ID_HELP,                VIRTKEY
[!endif]
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialogfeld
//
IDD_ABOUTBOX DIALOG DISCARDABLE   0, 0, 125, 55
CAPTION "Info über [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "[!output PROJECT_NAME] Version 1.0",IDC_STATIC,40,10,65,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC,40,25,65,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE  0, 0, 185, 93
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
	LTEXT	"TODO: Formular-Steuerelemente in diesem Dialogfeld positionieren.",IDC_STATIC,24,42,136,8
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
		BEGIN 
            VALUE "CompanyName", "TODO: <Firmenname>"
            VALUE "FileDescription", "TODO: <Dateibeschreibung>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "[!output PROJECT_NAME].exe"
            VALUE "LegalCopyright", "TODO: (c) <Firmenname>. Alle Rechte vorbehalten."
			VALUE "OriginalFilename","[!output PROJECT_NAME].exe"
            VALUE "ProductName", "TODO: <Produktname>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END


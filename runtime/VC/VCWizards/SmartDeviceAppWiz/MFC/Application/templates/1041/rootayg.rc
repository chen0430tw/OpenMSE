/////////////////////////////////////////////////////////////////////////////
//
// アイコン
//

// アプリケーションのアイコンをすべてのシステム上で維持するために、最も小さい
// ID 値のアイコンが最初に配置されます。

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
IDR_MAINFRAME		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME].ico"
[!if DOCVIEW && !APP_TYPE_DLG]
IDR_[!output SAFE_DOC_TYPE_NAME]TYPE		ICON	DISCARDABLE	"[!output RES_PATH]\\[!output PROJECT_NAME]Doc.ico"
[!endif]
#endif

[!if CMD_BAR_MENUNBUTTON]
/////////////////////////////////////////////////////////////////////////////
//
// ビットマップ
//

IDR_MAINFRAME		BITMAP	DISCARDABLE	"res\\Cmdbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// ツール バー
//

IDR_MAINFRAME TOOLBAR DISCARDABLE 16, 16
BEGIN
[!if DOCVIEW]
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
	SEPARATOR
[!endif]
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
	SEPARATOR
[!if DOCVIEW]
[!if PRINTING]
    BUTTON      ID_FILE_PRINT
[!endif]
[!endif]
[!if LIST_VIEW]
	SEPARATOR
    BUTTON      ID_VIEW_LARGEICON
    BUTTON      ID_VIEW_SMALLICON
    BUTTON      ID_VIEW_LIST
    BUTTON      ID_VIEW_DETAILS
[!endif]
[!if !APP_TYPE_SDI_DOCLIST]
    BUTTON      ID_APP_ABOUT
[!endif]
[!if HELPSTYLE_WINHELP]
    BUTTON      ID_CONTEXT_HELP
[!endif]
END
[!endif]

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])
LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]
#pragma code_page([!output SYSTEM_CODE_PAGE])
/////////////////////////////////////////////////////////////////////////////
//
// メニュー
//

IDR_MAINFRAME MENU  PRELOAD DISCARDABLE 
BEGIN
	POPUP "ファイル(&F)"
	BEGIN
[!if DOCVIEW]
		MENUITEM "新規作成\tCtrl+N(&N)",                ID_FILE_NEW
		MENUITEM "開く...\tCtrl+O(&O)",            ID_FILE_OPEN
		MENUITEM "上書き保存\tCtrl+S(&S)",               ID_FILE_SAVE
		MENUITEM "名前を付けて保存(&A)...",                 ID_FILE_SAVE_AS
[!if PRINTING]
		MENUITEM SEPARATOR
		MENUITEM "印刷...\tCtrl+P(&P)",           ID_FILE_PRINT
		MENUITEM "印刷プレビュー(&V)",              ID_FILE_PRINT_PREVIEW
		MENUITEM "プリンタの設定(&R)...",             ID_FILE_PRINT_SETUP
[!endif]
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "アプリケーションの終了(&X)",                       ID_APP_EXIT
	END
	POPUP "編集(&E)"
	BEGIN
		MENUITEM "元に戻す\tCtrl+Z(&U)",               ID_EDIT_UNDO
		MENUITEM SEPARATOR
		MENUITEM "切り取り\tCtrl+X(&T)",                ID_EDIT_CUT
		MENUITEM "コピー\tCtrl+C(&C)",               ID_EDIT_COPY
		MENUITEM "貼り付け\tCtrl+V(&P)",              ID_EDIT_PASTE
	END
[!if STATUS_BAR]
	POPUP "表示(&V)"
	BEGIN
		MENUITEM "ステータス バー(&S)",                 ID_VIEW_STATUS_BAR
[!if LIST_VIEW]
        	MENUITEM SEPARATOR
        	MENUITEM "大きいアイコン(&G)",                ID_VIEW_LARGEICON
        	MENUITEM "小さいアイコン(&M)",                ID_VIEW_SMALLICON
        	MENUITEM "一覧(&L)",                       ID_VIEW_LIST
        	MENUITEM "詳細(&D)",                    ID_VIEW_DETAILS
        	MENUITEM SEPARATOR
        	POPUP "アイコンの整列(&I)"
        	BEGIN
            		MENUITEM "名前順(&N)",                    ID_VIEW_BYNAME
            		MENUITEM SEPARATOR
            	MENUITEM "アイコンの自動整列(&A)",               ID_VIEW_AUTOARRANGE
        	END
        MENUITEM "等間隔に整列(&E)",              ID_VIEW_LINEUP
[!endif]

	END
[!endif]
	POPUP "ヘルプ(&H)"
	BEGIN
[!if HELPSTYLE_WINHELP]
		MENUITEM "トピックの検索(&H)",                ID_HELP_FINDER
		MENUITEM SEPARATOR
[!endif]
		MENUITEM "バージョン情報 [!output PROJECT_NAME](&A)...",          ID_APP_ABOUT
	END
END

[!if !SMARTPHONE2003_UI_MODEL]
/////////////////////////////////////////////////////////////////////////////
//
// アクセラレータ
//
IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
	"S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
[!if PRINTING]
	"P",            ID_FILE_PRINT,          VIRTKEY,CONTROL
[!endif]
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
	VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
	VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
	VK_INSERT,      ID_EDIT_COPY,           VIRTKEY,CONTROL
	VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
	VK_F6,          ID_NEXT_PANE,           VIRTKEY 
	VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
[!if HELPSTYLE_WINHELP]
	VK_F1,          ID_CONTEXT_HELP,        VIRTKEY,SHIFT
	VK_F1,          ID_HELP,                VIRTKEY
[!endif]
END

/////////////////////////////////////////////////////////////////////////////
//
// ダイアログ
//
IDD_ABOUTBOX DIALOG DISCARDABLE   0, 0, 125, 55
CAPTION "バージョン情報 [!output PROJECT_NAME]"
EXSTYLE WS_EX_CAPTIONOKBTN
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT [!output ABOUTBOX_FONT_SIZE], "MS UI Gothic"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "[!output PROJECT_NAME] Version 1.0",IDC_STATIC,40,10,65,8,SS_NOPREFIX
    LTEXT           "Copyright (C) [!output YEAR]",IDC_STATIC,40,25,65,8
END

[!if FORM_VIEW]
IDD_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_FORM DIALOG DISCARDABLE  0, 0, 185, 93
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS UI Gothic"
BEGIN
	LTEXT	"TODO: フォームのコントロールをここに配置してください。",IDC_STATIC,24,42,136,8
END
[!endif]

/////////////////////////////////////////////////////////////////////////////
//
// バージョン
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
		BEGIN 
            VALUE "CompanyName", "TODO: <会社名>"
            VALUE "FileDescription", "TODO: <ファイルの説明>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "[!output PROJECT_NAME].exe"
            VALUE "LegalCopyright", "TODO: (C) <会社名>.  All rights reserved."
			VALUE "OriginalFilename","[!output PROJECT_NAME].exe"
            VALUE "ProductName", "TODO: <製品名>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END


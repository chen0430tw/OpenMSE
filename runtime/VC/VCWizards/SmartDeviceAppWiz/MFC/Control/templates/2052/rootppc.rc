#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE 
BEGIN
    "resourceppc.h\0"
END

2 TEXTINCLUDE 
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE  
BEGIN
    "1 TYPELIB ""[!output SAFE_IDL_NAME].tlb""\r\n"
    "#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_[!output LANG_SUFFIX])\r\n"
    "LANGUAGE [!output PRIMARY_LANG_ID], [!output SUB_LANG_ID]\r\n"
    "#pragma code_page([!output SYSTEM_CODE_PAGE])\r\n"
    "#include ""[!output RC2_FILE_NAME].rc2""  // 非 Microsoft Visual C++ 编辑的资源\r\n"
    "#endif\r\n"
    "\0"
END

/////////////////////////////////////////////////////////////////////////////
#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// 版本
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "[!output HEX_LCID][!output HEX_CODE_PAGE]"
        BEGIN
            VALUE "CompanyName", "TODO: <公司名>"
            VALUE "FileDescription", "TODO: <文件说明>"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "[!output PROJECT_NAME].ocx"
            VALUE "LegalCopyright", "TODO: (C) <公司名>。保留所有权利。"
            VALUE "OriginalFilename", "[!output PROJECT_NAME].ocx"
            VALUE "ProductName", "TODO: <产品名>"
            VALUE "ProductVersion", "1.0.0.1"
            VALUE "OLESelfRegister", ""
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
		VALUE "Translation", 0x[!output HEX_LCID], [!output CODE_PAGE]
    END
END

[!if ABOUT_BOX]
/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

// ID 值最低的图标放在最前面，以确保应用程序图标
// 在所有系统中保持一致。
IDI_ABOUTDLL    ICON         "[!output PROJECT_NAME].ico"

[!endif]
/////////////////////////////////////////////////////////////////////////////
//
// 位图
//

IDB_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]   BITMAP   "[!output SHORT_NAME]Ctrl.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// 对话框
//

[!if ABOUT_BOX]

IDD_ABOUTBOX_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME] DIALOG 0, 0, 156, 129
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
EXSTYLE WS_EX_CAPTIONOKBTN
CAPTION "关于 [!output CONTROL_TYPE_NAME]"
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON         IDI_ABOUTDLL,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT        "[!output CONTROL_TYPE_NAME] 1.0  版",IDC_STATIC_2,12,36,70,8,SS_NOPREFIX
    LTEXT        "版权所有 (C) [!output YEAR]",IDC_STATIC_3,12,48,66,8
END

IDD_ABOUTBOX_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME]_WIDE DIALOG 0, 0, 210, 129
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
EXSTYLE WS_EX_CAPTIONOKBTN
CAPTION "关于 [!output CONTROL_TYPE_NAME]"
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    ICON         IDI_ABOUTDLL,IDC_STATIC_1,12,12,21,20,SS_REALSIZEIMAGE
    LTEXT        "[!output CONTROL_TYPE_NAME] 1.0  版",IDC_STATIC_2,48,12,66,8,SS_NOPREFIX
    LTEXT        "版权所有 (C) [!output YEAR]",IDC_STATIC_3,48,24,66,8
END

[!endif]

IDD_PROPPAGE_[!output UPPER_CASE_SAFE_PROJECT_IDENTIFIER_NAME] DIALOG 0, 0, 156, 129
STYLE WS_CHILD
FONT [!output ABOUTBOX_FONT_SIZE], "MS Shell Dlg"
BEGIN
    LTEXT           "TODO: 将用于操作 [!output CONTROL_TYPE_NAME] 的属性的控件放置在此对话框上。",
                    IDC_STATIC,18,42,120,24
END



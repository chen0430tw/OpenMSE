// [!output SAFE_IDL_NAME].idl : ActiveX 控件项目的类型库源。

// 此文件将由 MIDL 编译器工具处理以
// 产生类型库([!output SAFE_IDL_NAME].tlb)，该类型库将成为以下文件中的资源:
// [!output PROJECT_NAME].ocx 中的资源。

#include <olectl.h>

[ uuid([!output LIBID_REGISTRY_FORMAT]), version(1.0),
  helpfile("[!output PROJECT_NAME].hlp"),
  helpstring("[!output PROJECT_NAME] ActiveX 控件模块"),
  control ]
library [!output LIB_NAME]Lib
{
	importlib(STDOLE_TLB);
	importlib(STDTYPE_TLB);

	//  [!output CONTROL_CLASS] 的主调度接口

	[ uuid([!output PRIMARY_IID_REGISTRY_FORMAT]),
	  helpstring("[!output CONTROL_TYPE_NAME] 的调度接口"), hidden]
	dispinterface _D[!output SAFE_PROJECT_IDENTIFIER_NAME]
	{
		properties:
[!if ASYNC_PROPERTY_LOAD]
			[id(DISPID_READYSTATE), readonly] long ReadyState;
[!endif]
		methods:
[!if !MULTIPLE_PLATFORM]
[!if !SMARTPHONE2003_UI_MODEL]
[!if ABOUT_BOX]
			[id(DISPID_ABOUTBOX)] void AboutBox();
[!endif]
[!endif]
[!else]
[!if SMARTPHONE2003_UI_MODEL]
#ifndef WIN32_PLATFORM_WFSP
[!endif]
[!if ABOUT_BOX]
			[id(DISPID_ABOUTBOX)] void AboutBox();
[!endif]
[!if SMARTPHONE2003_UI_MODEL]
#endif // !WIN32_PLATFORM_WFSP
[!endif]
[!endif]
	};

	//  [!output CONTROL_CLASS] 的事件调度接口

	[ uuid([!output EVENT_IID_REGISTRY_FORMAT]),
	  helpstring("[!output CONTROL_TYPE_NAME] 的事件接口") ]
	dispinterface _D[!output SAFE_PROJECT_IDENTIFIER_NAME]Events
	{
		properties:
			//  事件接口没有任何属性

		methods:
[!if ASYNC_PROPERTY_LOAD]
			[id(DISPID_READYSTATECHANGE)] void ReadyStateChange();
[!endif]
	};

	//  [!output CONTROL_CLASS] 的类信息

[!if RUNTIME_LICENSE]
	[ uuid([!output CONTROL_CLSID]), licensed,
[!else]
	[ uuid([!output CONTROL_CLSID]),
[!endif]
	  helpstring("[!output CONTROL_TYPE_NAME]"), control ]
	coclass [!output LIB_NAME]
	{
		[default] dispinterface _D[!output SAFE_PROJECT_IDENTIFIER_NAME];
		[default, source] dispinterface _D[!output SAFE_PROJECT_IDENTIFIER_NAME]Events;
	};
};
